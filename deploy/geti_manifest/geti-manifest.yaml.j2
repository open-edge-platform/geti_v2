k3s_version: "v1.33.1+k3s1"
nvidia_drivers_version: "535.*.*"
intel_drivers_version: "1.3"
intel_device_plugin_version: $INTEL_DEVICE_PLUGIN_VERSION
is_upgrade_required: false

{% if 'nvidia' in gpu_label %}
---
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: nvidia-device-plugin
spec:
  repo: https://nvidia.github.io/k8s-device-plugin
  chart: nvidia-device-plugin
  version: v0.17.2
  targetNamespace: kube-system
  createNamespace: false
  timeout: 30m
  valuesContent: |-
    affinity:
      nodeAffinity:
        requiredDuringSchedulingIgnoredDuringExecution:
          nodeSelectorTerms:
          - matchExpressions:
            - key: "nvidia.com/gpu"
              operator: In
              values:
              - "true"
    image:
      repository: nvcr.io/nvidia/k8s-device-plugin
      tag: "v0.17.2-ubi9"
    runtimeClassName: nvidia
    failOnInitError: "false"
    deviceListStrategy: volume-mounts
    securityContext:
      allowPrivilegeEscalation: true
      privileged: true
    resources:
      requests:
        cpu: 50m
        memory: 50Mi
      limits:
        memory: 50Mi
{% endif %}

---
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: geti-namespaces
spec:
  version: $VERSION
  insecureSkipTLSVerify: true
  chart: "oci://{{ geti_registry }}/geti/helm/geti-namespaces"
  backOffLimit: 0
  failurePolicy: abort
---
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: reloader
spec:
  insecureSkipTLSVerify: true
  chart: "oci://{{ geti_registry }}/geti/helm/reloader"
  version: $VERSION
  targetNamespace: kube-system
  backOffLimit: 0
  failurePolicy: abort
---
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: geti-pv-creation
spec:
  insecureSkipTLSVerify: true
  chart: "oci://{{ geti_registry }}/geti/helm/geti-pv-creation"
  version: $VERSION
  targetNamespace: impt
  backOffLimit: 0
  failurePolicy: abort
  valuesContent: |-
    dataStoragePath: "{{ data_folder }}"
---
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
