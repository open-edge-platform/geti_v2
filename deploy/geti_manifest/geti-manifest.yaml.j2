spec:
  insecureSkipTLSVerify: true
  chart: "oci://{{ geti_registry }}/geti/helm/cert-manager"
  version: $VERSION
  targetNamespace: cert-manager
  backOffLimit: 0
  failurePolicy: abort
---
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: cert-manager-addon
spec:
  insecureSkipTLSVerify: true
  chart: "oci://{{ geti_registry }}/geti/helm/cert-manager-addon"
  version: $VERSION
  targetNamespace: cert-manager
---
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: cert-manager-istio-csr
spec:
  insecureSkipTLSVerify: true
  chart: "oci://{{ geti_registry }}/geti/helm/cert-manager-istio-csr"
  version: $VERSION
  targetNamespace: cert-manager
  backOffLimit: 0
  failurePolicy: abort
---
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: istio-base
spec:
  insecureSkipTLSVerify: true
  chart: "oci://{{ geti_registry }}/geti/helm/istio-base"
  version: $VERSION
  targetNamespace: istio-system
  backOffLimit: 0
  failurePolicy: abort
---
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: istio-istiod
spec:
  insecureSkipTLSVerify: true
  chart: "oci://{{ geti_registry }}/geti/helm/istio-istiod"
  version: $VERSION
  targetNamespace: istio-system
  backOffLimit: 0
  failurePolicy: abort
  valuesSecrets:
    - name: external-registry
      ignoreUpdates: true
      keys:
        - overrideRegistry
  valuesContent: |-
    global:
      proxy:
        excludeIPRanges: "10.43.0.1/32"
---
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: istio-gateway
spec:
  insecureSkipTLSVerify: true
  chart: "oci://{{ geti_registry }}/geti/helm/istio-gateway"
  version: $VERSION
  targetNamespace: istio-system
  backOffLimit: 0
  failurePolicy: abort
  valuesSecrets:
    - name: external-registry
      ignoreUpdates: true
      keys:
        - overrideRegistry
  valuesContent: |-
    tls:
      key_file: "{{ tls_key_file }}"
      cert_file: "{{ tls_cert_file }}"
---
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: geti-tools
spec:
  insecureSkipTLSVerify: true
  chart: "oci://{{ geti_registry }}/geti/helm/geti-tools"
  version: $VERSION
  targetNamespace: impt
  timeout: 20m
  backOffLimit: 0
  failurePolicy: abort
  valuesSecrets:
    - name: external-registry
      ignoreUpdates: true
      keys:
        - overrideRegistry
  valuesContent: |-
    global:
      registry_address: "{{ geti_registry }}"
    enabled:
      dcgm-exporter: {{ 'nvidia' in gpu_label | default(true) }}
      xpu-manager: {{ 'i915' in gpu_label | default(false) }}
---
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: geti-components
spec:
  insecureSkipTLSVerify: true
  chart: "oci://{{ geti_registry }}/geti/helm/geti-components"
  version: $VERSION
  targetNamespace: impt
  timeout: 60m
  backOffLimit: 0
  failurePolicy: abort
  valuesSecrets:
    - name: external-registry
      ignoreUpdates: true
      keys:
        - overrideRegistry
  valuesContent: |-
    configuration:
      dataStoragePath: "{{ data_folder }}"
      render_gid: {{ render_gid }}
      accelerator:
        type: {{ 'gpu' if gpu_label else 'cpu' }}
        name: {{ gpu_label | default('') }}
    global:
      registry_address: "{{ geti_registry }}"
      tag: "$TAG" # TODO temporary solution to get new images, remove when CI will be ready
      login: "{{ username }}"
      passwordHash: "{{ password_hash }}"
      dataFolder: "{{ data_folder }}"
      tlsCert: "{{ tls_cert_file }}"
      tlsKey: "{{ tls_key_file }}"
      imageRegistry: "{{ image_registry }}"
      proxy:
        enabled: "{{ proxy_enabled }}"
        https_proxy: "{{ https_proxy }}"
        http_proxy: "{{ http_proxy }}"
        no_proxy: "{{ no_proxy }}"
---
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
